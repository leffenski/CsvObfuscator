<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
    <PropertyGroup>
        <TargetFramework>net10.0-browser</TargetFramework>
        <OutputType>Exe</OutputType>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <Nullable>enable</Nullable>
        <!-- Avalonia's Skia renderer supplies a native WebAssembly library. Link it
             into dotnet.native.wasm so SKImageInfo and the rest of SkiaSharp load. -->
        <WasmBuildNative>true</WasmBuildNative>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.Browser"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\CsvObfuscator\CsvObfuscator.csproj"/>
    </ItemGroup>
</Project>
